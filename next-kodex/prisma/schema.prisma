generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  AUTHOR
}

model User {
  id       String @id @default(cuid())
  email    String @unique
  name     String
  password String
  role     Role   @default(AUTHOR)

  posts     BlogPost[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@map("users")
}

model BlogPost {
  id          String @id @default(cuid())
  title       String
  description String
  slug        String @unique
  image       String

  metaTitle       String?
  metaDescription String?
  keywords        String?

  author   User   @relation(fields: [authorId], references: [id])
  authorId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("blog_posts")
}
